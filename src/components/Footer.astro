---
import { locations, nav, physician, social } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-stone-300 bg-stone-100 text-slate-700">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        locations.map((place) => (
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-900">{place.city}</h2>
            <address class="mt-1 text-sm not-italic leading-snug">{place.shortAddress}</address>
          </div>
        ))
      }
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-900">Páginas</h2>
        <ul class="mt-1 space-y-1 text-sm">
          {
            nav.map((item) => (
              <li>
                <a class="hover:text-blue-700" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-900">Redes</h2>
        <ul class="mt-1 space-y-1 text-sm">
          {
            social.map((item) => (
              <li>
                <a class="hover:text-blue-700" href={item.href} rel="noopener noreferrer" target="_blank">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-stone-300 pt-6 text-sm leading-relaxed text-slate-900">
      <p>
        <strong>{physician.fullName}</strong>
      </p>
      <p class="mt-1">
        {physician.crm}
        <span aria-hidden="true"> · </span>
        {physician.rqe}
      </p>
      <p class="mt-2">
        Responsável técnico por este site: {physician.fullName}, {physician.crm}, {physician.rqe}.
      </p>
      <p class="mt-2 max-w-3xl text-slate-700">
        Conteúdo informativo, sem promessa de resultado. Não substitui a consulta médica.
      </p>
    </div>

    <div class="mt-6 flex flex-col items-center gap-2 border-t border-stone-300 pt-6 text-center text-xs text-slate-700 sm:flex-row sm:justify-center">
      <a href="/" aria-label="Página inicial do Dr. Felipe Poubel">
        <img
          src="/Logo_felipe_poubel%20sem%20fundo.png"
          alt=""
          width="220"
          height="107"
          class="h-12 w-auto"
        />
      </a>
      <p>© {year} Dr. Felipe Poubel. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
