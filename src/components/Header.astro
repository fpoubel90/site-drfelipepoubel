---
import { nav } from "../data/site";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string) {
  if (href === "/") return current === "/";
  return current === href || current.startsWith(`${href}/`);
}
---

<header class="border-b border-stone-200 bg-stone-100">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-6" aria-label="Principal">
    <a href="/" class="shrink-0" aria-label="Página inicial do Dr. Felipe Poubel">
      <img
        src="/Logo_felipe_poubel%20sem%20fundo.png"
        alt="Logo Dr. Felipe Poubel"
        width="410"
        height="200"
        class="h-16 w-auto md:h-24 lg:h-28"
      />
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class:list={[
                "rounded px-3 py-2 text-sm font-medium uppercase tracking-wider",
                isCurrent(item.href)
                  ? "text-blue-700"
                  : "text-slate-700 hover:text-blue-700",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="relative md:hidden">
      <summary class="cursor-pointer rounded px-3 py-2 text-sm font-semibold uppercase tracking-wider text-slate-800">
        Menu
      </summary>
      <ul class="absolute right-0 z-20 mt-2 w-56 rounded-lg border border-slate-200 bg-white p-2 shadow-xl">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class:list={[
                  "block rounded px-3 py-2 text-sm font-medium",
                  isCurrent(item.href) ? "bg-blue-50 text-blue-800" : "text-slate-800 hover:bg-stone-100",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
