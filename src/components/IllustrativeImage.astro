---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  imgClass?: string;
  loading?: "eager" | "lazy";
}

const { src, alt, width, height, imgClass = "", loading = "lazy" } = Astro.props;
---

<figure class="m-0">
  <img src={src} alt={alt} width={width} height={height} class={imgClass} loading={loading} />
  <figcaption class="bg-stone-200 px-3 py-1.5 text-sm font-semibold text-slate-900">
    Imagem ilustrativa
  </figcaption>
</figure>
