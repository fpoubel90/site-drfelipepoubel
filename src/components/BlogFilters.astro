---
import { audiences, type Audience } from "../lib/blog";

interface Props {
  audience?: Audience | "todos";
}
const { audience = "todos" } = Astro.props;

const options = [{ id: "todos", href: "/blog", label: "Todos" }, ...audiences.map((item) => ({
  id: item.id,
  href: `/blog/publico/${item.id}`,
  label: item.label,
}))];
---

<nav aria-label="Filtrar por público" class="mb-8 flex flex-wrap gap-2">
  {
    options.map((option) => (
      <a
        href={option.href}
        aria-current={option.id === audience ? "page" : undefined}
        class:list={[
          "rounded-full px-4 py-2 text-sm font-semibold",
          option.id === audience
            ? "bg-blue-700 text-white"
            : "bg-white text-slate-800 shadow hover:bg-stone-100",
        ]}
      >
        {option.label}
      </a>
    ))
  }
</nav>
