---
import { audienceLabel, formatPostDate, type BlogPost } from "../lib/blog";

interface Props {
  posts: BlogPost[];
}
const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="rounded-xl bg-white p-6 text-lg text-slate-700 shadow">
      Ainda não há artigos publicados. Os textos entram aqui quando deixam de ser rascunho.
    </p>
  ) : (
    <ul class="grid gap-6">
      {posts.map((post) => (
        <li>
          <article class="rounded-xl bg-white p-6 shadow">
            <p class="text-sm font-medium text-slate-700">
              <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
              <span aria-hidden="true"> · </span>
              <a class="text-blue-800 hover:text-blue-900" href={`/blog/publico/${post.data.audience}`}>
                {audienceLabel(post.data.audience)}
              </a>
            </p>
            <h2 class="mt-2 text-2xl font-bold text-slate-900">
              <a class="hover:text-blue-800" href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="mt-2 text-slate-700">{post.data.description}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <li>
                  <a class="rounded-full bg-stone-200 px-3 py-1 text-sm font-medium text-slate-900 hover:bg-stone-300" href={`/blog/tag/${tag}`}>
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ul>
  )
}
