---
interface Props {
  href?: string;
}
const { href = "/contato" } = Astro.props;
---

<p class="mt-12 border-t border-slate-200 pt-8 text-center">
  <a
    href={href}
    class="inline-block rounded-lg bg-blue-700 px-6 py-3 text-base font-semibold text-white shadow-lg hover:bg-blue-800 sm:px-8 sm:py-4 sm:text-lg"
  >
    <slot />
  </a>
</p>
