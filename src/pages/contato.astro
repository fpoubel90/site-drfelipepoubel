---
import Base from "../layouts/Base.astro";
import LocationCard from "../components/LocationCard.astro";
import { locations, social } from "../data/site";

const description =
  "Contato e locais de atendimento do Dr. Felipe Poubel: Clínica Lustig, em Laranja da Terra, e Hospital São Vicente de Paulo, em Afonso Cláudio.";
---

<Base title="Contato" description={description}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="mx-auto max-w-2xl text-center">
      <h1 class="text-4xl font-bold text-slate-900">Contato</h1>
      <p class="mt-4 text-lg text-slate-700">
        Atendo em diferentes locais para sua maior conveniência.
      </p>
    </header>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {locations.map((place) => <LocationCard place={place} />)}
    </div>
    <section class="mx-auto mt-12 max-w-3xl rounded-xl bg-white p-6 shadow-xl" aria-labelledby="redes-titulo">
      <h2 id="redes-titulo" class="text-2xl font-semibold text-slate-900">Redes</h2>
      <ul class="mt-4 space-y-2">
        {
          social.map((item) => (
            <li>
              <a class="font-semibold text-blue-800 hover:text-blue-900" href={item.href} rel="noopener noreferrer" target="_blank">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
