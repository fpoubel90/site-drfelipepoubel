---
import Base from "../layouts/Base.astro";
import { bio, physician } from "../data/site";

const description =
  "Felipe Poubel Timm do Carmo, CRM-ES 13423, RQE 11122 – Cirurgia Geral. Formação pela EMESCAM, residência em cirurgia geral e atuação em cuidados com a pele.";
---

<Base title="Sobre" description={description}>
  <article class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid items-start gap-10 rounded-xl bg-white p-6 shadow-xl md:grid-cols-2 md:p-10">
      <img
        src="/VIT_7643.jpg"
        alt="Dr. Felipe Poubel, de camisa azul, em foto de perfil"
        width="640"
        height="800"
        class="w-full rounded-xl object-cover shadow-lg"
      />
      <div>
        <h1 class="text-4xl font-bold text-slate-900">{physician.publicName}</h1>
        <p class="mt-3 text-lg font-semibold text-slate-900">{physician.fullName}</p>
        <p class="mt-2 text-base text-slate-800">{physician.crm}</p>
        <p class="text-base font-semibold text-slate-900">{physician.rqe}</p>
        <p class="mt-6 text-lg leading-relaxed text-slate-700">{bio.formation}</p>
        <p class="mt-4 text-lg leading-relaxed text-slate-700">{bio.practice}</p>
        <p class="mt-4 text-lg leading-relaxed text-slate-700">{bio.mission}</p>
        <p class="mt-8 flex flex-wrap gap-4">
          <a class="font-semibold text-blue-800 hover:text-blue-900" href="/areas">Áreas de atuação</a>
          <a class="font-semibold text-blue-800 hover:text-blue-900" href="/contato">Contato</a>
        </p>
      </div>
    </div>
  </article>
</Base>
