---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { audienceLabel, formatPostDate, getPublishedPosts } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} image={post.data.image?.src} ogType="article">
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-sm font-semibold text-blue-800"><a href="/blog">Blog</a></p>
    <h1 class="mt-3 text-4xl font-bold text-slate-900">{post.data.title}</h1>
    <p class="mt-4 text-slate-700">
      <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
      <span aria-hidden="true"> · </span>
      <a class="font-semibold text-blue-800" href={`/blog/publico/${post.data.audience}`}>
        {audienceLabel(post.data.audience)}
      </a>
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        post.data.tags.map((tag) => (
          <li>
            <a class="rounded-full bg-white px-3 py-1 text-sm font-medium text-slate-900 shadow hover:bg-stone-100" href={`/blog/tag/${tag}`}>
              {tag}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="prose prose-slate mt-8 max-w-none">
      <Content />
    </div>
  </article>
</Base>
