---
import Base from "../../../layouts/Base.astro";
import BlogList from "../../../components/BlogList.astro";
import { getPublishedPosts } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag ?? "";
const posts = (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag));
const description = `Artigos do Dr. Felipe Poubel com a tag ${tag}.`;
---

<Base title={`Tag: ${tag}`} description={description}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-sm font-semibold text-blue-800"><a href="/blog">Blog</a></p>
    <h1 class="mt-3 text-4xl font-bold text-slate-900">Tag: {tag}</h1>
    <div class="mt-8">
      <BlogList posts={posts} />
    </div>
  </div>
</Base>
