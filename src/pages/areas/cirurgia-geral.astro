---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { cirurgiaGeralIntro, cirurgiaGeralTopics } from "../../data/cirurgia-geral";

const description =
  "Informações sobre cirurgia geral com o Dr. Felipe Poubel: pedra na vesícula, hérnias abdominais e outros procedimentos.";
---

<Base title="Cirurgia geral" description={description}>
  <article class="bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <p class="text-sm font-semibold text-blue-800">
        <a href="/areas">Áreas de atuação</a>
      </p>
      <h1 class="mt-3 text-center text-4xl font-bold text-slate-900 sm:text-5xl">Cirurgia geral</h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-slate-700">{cirurgiaGeralIntro}</p>

      {
        cirurgiaGeralTopics.map((topic) => (
          <section id={topic.id} class="mt-14 scroll-mt-24 border-t border-slate-200 pt-10">
            <h2 class="text-3xl font-semibold text-slate-900">{topic.title}</h2>
            <div class="mt-8 grid items-start gap-8 md:grid-cols-12">
              <img
                src={topic.image}
                alt={topic.imageAlt}
                width="800"
                height="600"
                class="aspect-[4/3] w-full rounded-xl object-cover shadow-lg md:col-span-5"
                loading="lazy"
              />
              <div class="space-y-5 md:col-span-7">
                {topic.blocks.map((block) => (
                  <div
                    class:list={[
                      "rounded-xl p-4",
                      block.kind === "warning"
                        ? "border border-amber-400 bg-amber-50 text-amber-950"
                        : "bg-slate-50 text-slate-800",
                    ]}
                  >
                    <h3 class="text-xl font-semibold">{block.title}</h3>
                    {block.kind === "text" &&
                      block.paragraphs.map((paragraph) => (
                        <p class="mt-2 text-sm leading-relaxed sm:text-base">{paragraph}</p>
                      ))}
                    {block.kind === "list" && (
                      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed sm:text-base">
                        {block.items.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    )}
                    {block.kind === "warning" && (
                      <>
                        <p class="mt-2 text-sm leading-relaxed sm:text-base">{block.intro}</p>
                        {block.items.length > 0 && (
                          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed sm:text-base">
                            {block.items.map((item) => (
                              <li>{item}</li>
                            ))}
                          </ul>
                        )}
                      </>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </section>
        ))
      }

      <Cta>Agendar consulta ou saber mais</Cta>
    </div>
  </article>
</Base>
