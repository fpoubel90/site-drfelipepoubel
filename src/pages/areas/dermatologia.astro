---
import Base from "../../layouts/Base.astro";
import { bio } from "../../data/site";

const description =
  "Cuidados com a pele na prática do Dr. Felipe Poubel, com o conteúdo já publicado sobre lesões cutâneas, pequenas cirurgias e câncer de pele.";
---

<Base title="Dermatologia" description={description}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-sm font-semibold text-blue-800">
      <a href="/areas">Áreas de atuação</a>
    </p>
    <h1 class="mt-3 text-4xl font-bold text-slate-900">Dermatologia</h1>
    <div class="mt-8 space-y-4 rounded-xl bg-white p-6 text-lg leading-relaxed text-slate-700 shadow-xl sm:p-8">
      <p>{bio.formation}</p>
      <p>{bio.practice}</p>
      <p>
        Os textos sobre pele estão nas páginas de
        <a class="font-semibold text-blue-800 hover:text-blue-900" href="/areas/cirurgia-dermatologica">cirurgia dermatológica</a>
        e de
        <a class="font-semibold text-blue-800 hover:text-blue-900" href="/areas/cancer-de-pele">câncer de pele</a>.
      </p>
      <p>
        O anúncio do título de especialista depende do RQE correspondente, indicado no rodapé.
      </p>
    </div>
    <img
      src="/dermatoscopio.png"
      alt="Dermatoscópio usado no exame de lesões da pele"
      width="800"
      height="600"
      class="mt-8 w-full rounded-xl object-cover shadow-lg"
      loading="lazy"
    />
  </article>
</Base>
