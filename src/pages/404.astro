---
import Base from "../layouts/Base.astro";
---

<Base title="Página não encontrada" description="A página solicitada não existe no site do Dr. Felipe Poubel.">
  <div class="mx-auto max-w-xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold text-slate-900">Página não encontrada</h1>
    <p class="mt-4 text-lg text-slate-700">O endereço não corresponde a uma página deste site.</p>
    <p class="mt-6">
      <a class="font-semibold text-blue-800" href="/">Voltar ao início</a>
    </p>
  </div>
</Base>
